# Match & Munch — Variables d'environnement backend
# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True

# Base de données PostgreSQL (locale ou Railway)
DB_NAME=matchmuunch
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Hôtes autorisés
ALLOWED_HOSTS=localhost,127.0.0.1

# APIs externes
SPORTSDB_KEY=         # TheSportsDB — clé sur thesportsdb.com
ANTHROPIC_API_KEY=       # Anthropic — pour les suggestions de recettes (optionnel en dev)
