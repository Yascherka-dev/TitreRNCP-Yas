# Match & Munch — Variables d'environnement backend
# Copier ce fichier en .env et remplir les valeurs

# OBLIGATOIRE — aucune valeur par défaut, le serveur refuse de démarrer sans.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False par défaut. Ne passer à True qu'en développement local.
DEBUG=True

# Base de données PostgreSQL
# Prod (Railway) : définir DATABASE_URL, les variables séparées seront ignorées.
# Dev (local)    : laisser DATABASE_URL vide et remplir les variables ci-dessous.
DATABASE_URL=
DB_NAME=matchmuunch
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — domaines front autorisés, séparés par des virgules
# Dev : http://localhost:4200
# Prod : ajouter le domaine Vercel, ex. https://match-and-munch.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Hôtes autorisés, séparés par des virgules — indispensable une fois DEBUG=False
# Dev : localhost,127.0.0.1
# Prod : ajouter le domaine backend, ex. titrerncp-yas.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# APIs externes
SPORTSDB_KEY=         # TheSportsDB — clé sur thesportsdb.com
ANTHROPIC_API_KEY=       # Anthropic — pour les suggestions de recettes (optionnel en dev)
